# ==============================================================================
# PulseChat Environment Variables Template
# Copy this file to .env and configure for your environment
# ==============================================================================

# Application Profile & Port
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Production Database (PostgreSQL Default)
DB_URL=jdbc:postgresql://postgres:5432/pulsechatdb
DB_USERNAME=postgres
DB_PASSWORD=pulse_secret_password_here
DB_DRIVER=org.postgresql.Driver

# Alternative: MySQL Configuration (Uncomment to use MySQL)
# DB_URL=jdbc:mysql://mysql:3306/pulsechatdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=pulse_secret_password_here
# DB_DRIVER=com.mysql.cj.jdbc.Driver

# Connection Pool Tuning
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5
